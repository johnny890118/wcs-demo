# Local prototype authentication only. Do not reuse these placeholders.
NEXTAUTH_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
DEMO_ADMIN_USERNAME=replace-with-a-local-demo-username
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
HUMAN_SESSION_TTL_SECONDS=28800
HUMAN_SESSION_REVOCATION_ATTEMPTS=3
HUMAN_SESSION_REVOCATION_RETRY_MS=250
HUMAN_LOGIN_FAILURE_LIMIT=5
HUMAN_LOGIN_FAILURE_WINDOW_SECONDS=900
HUMAN_LOGIN_THROTTLE_SECONDS=900
# Anonymous public-demo scope only. Human demo access comes from persisted
# access_principals and warehouse_access_assignments seeded in the demo database.
DEMO_WAREHOUSE_ID=10000000-0000-4000-8000-000000000001
DEMO_WAREHOUSE_CODE=DEMO
DEMO_WAREHOUSE_NAME=Deterministic Demo Warehouse
SWP_LIFECYCLE_ENVIRONMENT=development
SWP_DEPLOYMENT_PROFILE=private_demo
SWP_EQUIPMENT_SOURCE=simulation

# Required only for the public_demo profile. Generate a distinct random secret.
ANONYMOUS_DEMO_SECRET=replace-with-a-long-random-anonymous-demo-secret
ANONYMOUS_DEMO_SESSION_TTL_SECONDS=1800
PUBLIC_DEMO_USER_PERMISSIONS=operations.view

# NestJS API and PostgreSQL. Use a non-production local database here.
API_PORT=3001
API_HOST=127.0.0.1
API_SERVICE_ID=local-web
API_SERVICE_TOKEN=replace-with-a-long-random-service-token
API_SERVICE_PERMISSIONS=access.resolve,audit.view,operations.view,inbound.create,outbound.create,transport.execute,alarm.inject,alarm.acknowledge,alarm.recover
INTERNAL_API_BASE_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://warehouse:replace-with-a-local-password@localhost:5432/warehouse
OUTBOX_POLL_INTERVAL_MS=1000
SIMULATOR_HEARTBEAT_MS=10000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY_HOPS=0

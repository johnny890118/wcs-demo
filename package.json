{
  "name": "wcs-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "db:migrate": "tsx apps/api/src/database/migrate.ts",
    "db:seed:demo": "tsx apps/api/src/database/seed-demo.ts",
    "db:reset:demo": "tsx apps/api/src/database/reset-demo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres-integration.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"apps/**/*.ts\" \"components/**/*.{ts,tsx}\" \"docs/**/*.md\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{js,ts}\" \"pages/**/*.{ts,tsx}\" \"pages/api/**/*.js\" \"scripts/*.mjs\" \"*.config.mjs\" AGENTS.md README.md package.json tsconfig.json",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run format:check && npm run security:secrets && npm run security:dependencies && npm run lint && npm run typecheck && npm run test && npm run test:postgres && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "axios": "^1.20.0",
    "chakra": "^0.0.3",
    "chart.js": "^4.4.1",
    "classnames": "^2.3.2",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sass": "^1.69.7"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.23.3",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.5",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

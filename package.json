{
  "name": "wcs-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "db:migrate": "tsx apps/api/src/database/migrate.ts",
    "db:seed:demo": "tsx apps/api/src/database/seed-demo.ts",
    "db:reset:demo": "tsx apps/api/src/database/reset-demo.ts",
    "deployment:validate": "node scripts/validate-deployment-env.mjs",
    "build": "npm run manual:integrity && next build",
    "build:api": "tsc -p tsconfig.api.json && esbuild dist/api/apps/api/src/main.js dist/api/apps/api/src/database/migrate.js dist/api/apps/api/src/database/seed-demo.js dist/api/apps/api/src/database/reset-demo.js --bundle --platform=node --format=esm --packages=external --outdir=dist/runtime --out-extension:.js=.mjs",
    "start:api:compiled": "node dist/runtime/main.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:managed-demo": "node scripts/check-managed-demo.mjs",
    "test:demo-boundary": "node scripts/check-demo-admission-boundary.mjs",
    "test:postgres": "node scripts/test-postgres-integration.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"apps/**/*.ts\" \"components/**/*.{ts,tsx}\" \"docs/**/*.md\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{js,ts,tsx,mjs}\" \"pages/**/*.{ts,tsx}\" \"pages/api/**/*.js\" \"scripts/*.{mjs,ts}\" \"*.config.{mjs,ts}\" AGENTS.md README.md package.json tsconfig.json",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "icons:generate": "node scripts/generate-product-icons.mjs",
    "icons:check": "node scripts/generate-product-icons.mjs --check",
    "manual:check": "tsx scripts/check-manual-pdfs.ts",
    "manual:integrity": "tsx scripts/check-manual-pdfs.ts --integrity-only",
    "verify": "npm run format:check && npm run security:secrets && npm run icons:check && npm run manual:check && npm run security:dependencies && npm run lint && npm run typecheck && npm run test && npm run test:postgres && npm run test:e2e && npm run test:demo-boundary"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "axios": "^1.20.0",
    "chakra": "^0.0.3",
    "chart.js": "^4.4.1",
    "classnames": "^2.3.2",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sass": "^1.69.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/preset-react": "^7.23.3",
    "@nestjs/testing": "^12.0.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.5",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

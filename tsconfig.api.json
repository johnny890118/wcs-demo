{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist/api",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["apps/api/src/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "tests", "src/ui/**/*.tsx"]
}
